# Salin ke .env.local (lokal) dan isi juga di Vercel → Settings → Environment Variables
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Hanya untuk melihat tampilan tanpa database (JANGAN diisi di Vercel):
# DEMO_MODE=1

# Opsional — sinkron ke Google Sheet untuk audit (lihat README):
# SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/xxxx/exec
# SHEETS_WEBHOOK_SECRET=samakan-dengan-SECRET-di-Code.gs
# NEXT_PUBLIC_SHEET_URL=https://docs.google.com/spreadsheets/d/xxxx

# Opsional — pengingat Telegram (lihat README): token dari @BotFather, rahasia cron, dan service role (JANGAN pakai NEXT_PUBLIC_)
# TELEGRAM_BOT_TOKEN=123456:ABC...
# CRON_SECRET=string-acak-panjang
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Opsional — Kantor Arus (repo kantor-ai): alamat web kantor. Kalau diisi, Ringkasan menampilkan kartu kecil status kantor.
# NEXT_PUBLIC_KANTOR_URL=https://kantor-anda.vercel.app
